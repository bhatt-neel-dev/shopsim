# The virtual shoppers: headless Chromium (Playwright's headless shell) and nothing else.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app
COPY requirements-shoppers.txt .
RUN pip install -r requirements-shoppers.txt \
 && playwright install --with-deps --only-shell chromium \
 && rm -rf /var/lib/apt/lists/*
COPY shopsim ./shopsim

ENTRYPOINT ["python", "-m", "shopsim"]
CMD ["shoppers"]
