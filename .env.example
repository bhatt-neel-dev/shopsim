# Copy to .env next to docker-compose.yml and adjust. Everything here has a working default.

# Where traces and metrics go (OTLP/HTTP). A Motadata agent/appliance listens on 4318.
OTLP_ENDPOINT=http://127.0.0.1:4318
# Optional: send traces somewhere else (full URL incl. /v1/traces). Empty = OTLP_ENDPOINT.
OTLP_TRACES_ENDPOINT=

# Where logs go over syslog (UDP). Use the host's own IP rather than 127.0.0.1 so the
# receiver sees a real source address for the log source.
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514

# JSON log files on the host, one per service.
LOG_DIR=/var/log/shopsim

# Shows up as deployment.environment on every span, metric and log line.
SHOPSIM_ENV=lab

# Optional: protect the control panel with HTTP basic auth (user "admin").
SHOPSIM_CONTROL_PASSWORD=

# Safety caps for spikes (this often runs next to other things).
SHOPSIM_MAX_TOTAL_RPS=600
SHOPSIM_MAX_BURN_CORES=2
SHOPSIM_MAX_BURN_MB=300
